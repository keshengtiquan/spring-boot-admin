<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.dadaz</groupId>
        <artifactId>spring-boot-admin</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dd-base</artifactId>
    <packaging>jar</packaging>

    <name>dd-base</name>
    <description>
        基础设施与通用能力层：统一响应 R、响应码、业务异常与全局异常处理、接口文档配置，
        以及 MyBatis-Plus / Druid / p6spy 等持久层基础依赖。
        本模块不含启动类，不可独立运行，只作为其他模块的依赖。
    </description>

    <dependencies>
        <!-- Web 基础：统一响应、全局异常处理、@RestController 等均依赖于此 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- R 上的 @Schema、Knife4jConfig 的 OpenAPI 模型 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>

        <!-- 持久层基础设施：业务模块（含 dd-admin）通过本模块的传递依赖获得 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- 开发期 SQL 打印代理驱动 -->
        <dependency>
            <groupId>p6spy</groupId>
            <artifactId>p6spy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <!-- MySQL 驱动：p6spy / Druid 都只是代理层，最终仍需要真实驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>

        <!--
          参数校验：spring-boot-starter-web 自 Spring Boot 2.3 起不再携带校验实现，
          缺了它 @Valid / @NotBlank 会被静默忽略（不报错，但也不校验），
          GlobalExceptionHandler 里的 MethodArgumentNotValidException 分支也就永远进不去。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          密码哈希：只取 spring-security-crypto 这一小块（BCryptPasswordEncoder）。
          刻意不引 spring-boot-starter-security —— 那会带来整条过滤器链和默认登录页，
          与本项目的 Sa-Token 鉴权方案冲突。本依赖只是工具类，无自动配置。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!--
          Lombok：仅编译期生效，不进入运行时；version 由 spring-boot-dependencies 统一管理（3.2.5 -> 1.18.32）。
          optional 保证不会作为传递依赖泄漏给 dd-admin —— 各模块按需自己声明，避免版本/使用范围失控。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
